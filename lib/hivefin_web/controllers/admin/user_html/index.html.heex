<Layouts.admin flash={@flash} current_user={@current_user} active={@active}>
  <.page_header title="Users">
    Accounts for Jellyfin clients and this admin console
  </.page_header>

  <div class="grid gap-6 lg:grid-cols-5">
    <div class="lg:col-span-3">
      <.card>
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Username</th>
                <th>Name</th>
                <th>Role</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <tr :for={user <- @users}>
                <td class="font-medium">{user.username}</td>
                <td>{user.name}</td>
                <td>
                  <span :if={user.admin} class="badge badge-primary badge-sm">admin</span>
                  <span :if={!user.admin} class="badge badge-ghost badge-sm">user</span>
                </td>
                <td class="text-right">
                  <details class="dropdown dropdown-end">
                    <summary class="btn btn-ghost btn-sm">⋯</summary>
                    <div class="menu dropdown-content z-10 mt-1 w-64 rounded-box border border-base-300 bg-base-200 p-3 shadow">
                      <.form
                        for={%{}}
                        action={~p"/admin/users/#{user.id}/password"}
                        method="post"
                        class="space-y-2"
                      >
                        <.input
                          name="password"
                          type="password"
                          label="New password"
                          required={true}
                          minlength="8"
                          autocomplete="new-password"
                        />
                        <.button type="submit" variant="secondary" class="w-full">
                          Reset password
                        </.button>
                      </.form>
                      <.form
                        :if={user.id != @current_user.id}
                        for={%{}}
                        action={~p"/admin/users/#{user.id}"}
                        method="post"
                        class="mt-3 border-t border-base-300 pt-3"
                        onsubmit="return confirm('Delete this user?')"
                      >
                        <input type="hidden" name="_method" value="delete" />
                        <.button type="submit" variant="danger" class="w-full">Delete user</.button>
                      </.form>
                    </div>
                  </details>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </.card>
    </div>

    <div class="lg:col-span-2">
      <.card>
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-base-content/50">
          Add user
        </h2>
        <.form for={%{}} as={:user} action={~p"/admin/users"} method="post" class="space-y-4">
          <.input name="user[username]" label="Username" required={true} autocomplete="off" />
          <.input name="user[name]" label="Display name" placeholder="Optional" />
          <.input
            name="user[password]"
            type="password"
            label="Password"
            required={true}
            minlength="8"
            autocomplete="new-password"
          />
          <label class="label cursor-pointer justify-start gap-3">
            <input type="checkbox" name="user[admin]" value="true" class="checkbox checkbox-sm" />
            <span class="label-text">Administrator</span>
          </label>
          <.button type="submit">Create user</.button>
        </.form>
      </.card>
    </div>
  </div>
</Layouts.admin>
