# Copy to .env and fill in secrets before `docker compose up`.
#   cp .env.example .env

# --- Required ---
# Generate:  mix phx.gen.secret   (or: openssl rand -base64 48)
SECRET_KEY_BASE=replace-with-long-random-string

# First admin account (only used when the users table is empty)
HIVEFIN_ADMIN_USER=admin
HIVEFIN_ADMIN_PASSWORD=change-me-to-a-long-password

# Postgres (compose service name is "db")
POSTGRES_USER=hivefin
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=hivefin

# --- Networking ---
# Host port published for Hivefin HTTP
HIVEFIN_PORT=4000

# Public hostname clients use (no scheme). For LAN: your server IP or hostname.
PHX_HOST=192.168.1.10

# Advertised Jellyfin LocalAddress (scheme + host + port clients should call)
HIVEFIN_LOCAL_ADDRESS=http://192.168.1.10:4000

# URL generation (admin redirects, absolute links)
PHX_SCHEME=http
PHX_URL_PORT=4000

# false = plain HTTP (typical Docker/LAN). true when reverse proxy sets X-Forwarded-Proto.
HIVEFIN_FORCE_SSL=false

# --- Media ---
# Host path to your library roots (mounted read-only at /media in the container).
# In the admin UI, add libraries under paths like /media/movies or /media/tv.
MEDIA_HOST_PATH=/path/to/your/media

# --- Optional ---
HIVEFIN_SERVER_NAME=Hivefin
HIVEFIN_TMDB_API_KEY=
HIVEFIN_HW_ACCEL=auto
HIVEFIN_MAX_TRANSCODES=2
POOL_SIZE=10
